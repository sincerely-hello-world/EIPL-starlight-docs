{
  "name": "eipl-starlight-docs",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "dev:cms": "astro dev --config astro.config.cms.mjs --background",
    "cms:status": "astro dev status --config astro.config.cms.mjs",
    "cms:logs": "astro dev logs --config astro.config.cms.mjs",
    "cms:stop": "astro dev stop --config astro.config.cms.mjs",
    "start": "astro dev",
    "build": "astro build && node scripts/prepare-cloudflare.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.12",
    "@astrojs/react": "^7.1.8",
    "@astrojs/starlight": "^0.42.8",
    "astro": "^7.2.10",
    "astro-mermaid": "^2.2.0",
    "emdash": "^1.5.0",
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.2",
    "satteri": "0.10.5",
    "sharp": "^0.35.3"
  },
  "private": true,
  "packageManager": "pnpm@12.18.0"
}
